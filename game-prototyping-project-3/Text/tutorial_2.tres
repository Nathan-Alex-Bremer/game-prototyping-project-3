[resource]
script = ExtResource("1_w0i7d")
dialogue = Array[String](["Great work! Now you can see the creature's HEALTH, HUNGER, FEISTINESS, and TIREDNESS. Creatures won't stick around if their health or hunger gets too low, so be careful!", "As you take pictures, I'll be able to get you permits for other interaction modes besides just checking. You'll be able to use the Interact Bar at the top of your screen to switch between them.", "Oh! I should probably tell you how to use the camera, shouldn't I?", "To take a picture, just position your mouse over a creature and left-click. Try it out!"])
metadata/_custom_type_script = "uid://dwjeik6rfd36d"
